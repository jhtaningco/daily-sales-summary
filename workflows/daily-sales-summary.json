    {
      "parameters": {
        "jsCode": "const today = $now.toFormat('yyyy-MM-dd');\nconst rows = $input.all()\n  .map(i => i.json)\n  .filter(r => String(r.date).trim() === today);\n\nif (rows.length === 0) {\n  return [{ json: {\n    date: today, orders: 0, totalSales: 0,\n    topItem: 'N/A', itemsSummary: 'No sales recorded today.'\n  } }];\n}\n\nlet totalSales = 0;\nconst byItem = {};\nfor (const r of rows) {\n  const qty = Number(r.quantity) || 0;\n  const price = Number(r.price) || 0;\n  totalSales += qty * price;\n  byItem[r.item] = (byItem[r.item] || 0) + qty;\n}\n\nconst sorted = Object.entries(byItem).sort((a, b) => b[1] - a[1]);\n\nreturn [{ json: {\n  date: today,\n  orders: rows.length,\n  totalSales,\n  topItem: sorted[0][0],\n  itemsSummary: sorted.map(([name, qty]) => `${name}: ${qty}`).join(', ')\n} }];"
      },
